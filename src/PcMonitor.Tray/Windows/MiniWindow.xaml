<Window x:Class="PcMonitor.Tray.Windows.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Caixa-Preta"
        Width="260" Height="40"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="#0a0a0a">
  <!-- No resize border and no maximize box: Snap would take the panel over when it is dragged to a screen corner.
       The page's grip resizes it through ResizeDrag instead. -->
  <wv2:WebView2 x:Name="View" />
</Window>
