<Window x:Class="PcMonitor.Tray.Windows.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Caixa-Preta"
        Width="260" Height="40"
        WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" Topmost="True"
        Background="#0a0a0a">
  <!-- Resizable (the page's grip starts it) but with no visible frame or resize border of its own. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <wv2:WebView2 x:Name="View" />
</Window>
