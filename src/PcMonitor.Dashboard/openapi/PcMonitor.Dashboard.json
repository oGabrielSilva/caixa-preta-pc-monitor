{
  "openapi": "3.1.1",
  "info": {
    "title": "PcMonitor.Dashboard | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "required": [
          "status",
          "version",
          "storage"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` when the dashboard answers."
          },
          "version": {
            "type": "string",
            "description": "Semantic version of the dashboard."
          },
          "storage": {
            "description": "State of the monitoring database; data endpoints answer 503 unless it is `Ready`.",
            "$ref": "#/components/schemas/StorageState"
          }
        },
        "description": "Liveness of the dashboard, the version that is running and whether the database can be read."
      },
      "StorageState": {
        "enum": [
          "Ready",
          "Missing",
          "SchemaTooOld",
          "SchemaTooNew",
          "Unreadable"
        ],
        "description": "Whether the database can be read by this build."
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    }
  ]
}