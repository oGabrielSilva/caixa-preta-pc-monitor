{
  "openapi": "3.1.1",
  "info": {
    "title": "PcMonitor.Dashboard | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/incidents": {
      "get": {
        "tags": [
          "Incidents"
        ],
        "operationId": "ListIncidents",
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IncidentSummaryResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/incidents/{id}": {
      "get": {
        "tags": [
          "Incidents"
        ],
        "operationId": "GetIncident",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/live": {
      "get": {
        "tags": [
          "Live"
        ],
        "operationId": "GetLive",
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/live/stream": {
      "get": {
        "tags": [
          "Live"
        ],
        "description": "Server-sent events (`frames`, `segment`, `state`) after the frame `after` (Unix ms) of segment `segmentId`.",
        "operationId": "StreamLive",
        "parameters": [
          {
            "name": "segmentId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/LiveEvent"
                }
              }
            }
          }
        }
      }
    },
    "/api/history/sensors": {
      "get": {
        "tags": [
          "History"
        ],
        "operationId": "ListHistorySensors",
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SensorResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/history": {
      "get": {
        "tags": [
          "History"
        ],
        "description": "Min, mean and max of `sensor` (stable key) over `range`, in buckets sized for the period.",
        "operationId": "GetHistory",
        "parameters": [
          {
            "name": "sensor",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "range",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/HistoryRange"
            }
          }
        ],
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BucketResponse": {
        "required": [
          "t",
          "min",
          "avg",
          "max"
        ],
        "type": "object",
        "properties": {
          "t": {
            "type": "integer",
            "format": "int64"
          },
          "min": {
            "type": "number",
            "format": "double"
          },
          "avg": {
            "type": "number",
            "format": "double"
          },
          "max": {
            "type": "number",
            "format": "double"
          }
        },
        "description": "One point of the history chart: `t` (Unix ms) is the start of the bucket."
      },
      "Confidence": {
        "enum": [
          "Inconclusive",
          "Low",
          "Medium",
          "High",
          null
        ]
      },
      "DiagnosisResponse": {
        "required": [
          "engineVersion",
          "diagnosedAt",
          "ranking",
          "findings",
          "limitations"
        ],
        "type": "object",
        "properties": {
          "engineVersion": {
            "type": "integer",
            "description": "Version of the rules that produced it.",
            "format": "int32"
          },
          "diagnosedAt": {
            "type": "string",
            "description": "When it was computed.",
            "format": "date-time"
          },
          "ranking": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HypothesisScoreResponse"
            },
            "description": "Hypotheses by score, highest first."
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FindingResponse"
            },
            "description": "Evidence and observations."
          },
          "limitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FindingResponse"
            },
            "description": "What this case cannot tell."
          }
        },
        "description": "The stored diagnosis of an incident."
      },
      "EventResponse": {
        "required": [
          "provider",
          "eventId",
          "loggedAt",
          "level"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "eventId": {
            "type": "integer",
            "format": "int32"
          },
          "loggedAt": {
            "type": "string",
            "format": "date-time"
          },
          "level": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "A Windows event around the incident. Its data is never sent: it can name the computer and the user."
      },
      "EvidenceStrength": {
        "enum": [
          "Weak",
          "Moderate",
          "Strong"
        ],
        "description": "How much a piece of evidence weighs; the value is its score."
      },
      "FailureTimeSource": {
        "enum": [
          "LastFrame",
          "LastFrameBeforeSleep",
          "LastAliveEventLog",
          "Unknown"
        ],
        "description": "Where the estimated failure time of an incident comes from, from most to least precise."
      },
      "FindingCode": {
        "enum": [
          "thermal.critical",
          "thermal.at_limit",
          "thermal.normal",
          "rail.out_of_tolerance",
          "rail.droop",
          "rail.in_tolerance",
          "load.high",
          "load.idle",
          "restart.quick",
          "restart.stayed_off",
          "power.transition",
          "bugcheck",
          "bugcheck.none",
          "whea.hardware_error",
          "whea.pcie",
          "power_button.long_press",
          "power_button.pressed",
          "boot.early_failure",
          "telemetry.missing",
          "telemetry.not_at_failure",
          "telemetry.too_short",
          "estimate.lower_bound",
          "sensor.unavailable",
          "rail.precision",
          "rail.measured_on_board",
          "whea.may_be_power"
        ],
        "type": "string",
        "description": "A diagnosis code (see `docs/architecture/diagnosis.md`). Serialized as a plain string; the OpenAPI document\r\nlists every value (FindingCodeSchemaTransformer) so the frontend gets a union type."
      },
      "FindingKind": {
        "enum": [
          "Evidence",
          "Observation",
          "Limitation"
        ],
        "description": "What a finding is for."
      },
      "FindingResponse": {
        "required": [
          "code",
          "kind",
          "hypothesis",
          "supports",
          "strength",
          "parameters"
        ],
        "type": "object",
        "properties": {
          "code": {
            "description": "Stable code.",
            "$ref": "#/components/schemas/FindingCode"
          },
          "kind": {
            "description": "Evidence (scores), observation or limitation.",
            "$ref": "#/components/schemas/FindingKind"
          },
          "hypothesis": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Hypothesis the evidence is about; `null` for observations and limitations.",
                "$ref": "#/components/schemas/Hypothesis"
              }
            ]
          },
          "supports": {
            "type": "boolean",
            "description": "For or against the hypothesis."
          },
          "strength": {
            "description": "Weight of the evidence.",
            "$ref": "#/components/schemas/EvidenceStrength"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Values the text needs, as invariant strings (for example `observed` = `11.28`)."
          }
        },
        "description": "One result of a diagnosis rule. The dashboard translates the code and its parameters."
      },
      "FramePoint": {
        "required": [
          "t",
          "values"
        ],
        "type": "object",
        "properties": {
          "t": {
            "type": "integer",
            "format": "int64"
          },
          "values": {
            "type": "array",
            "items": {
              "type": [
                "null",
                "number"
              ],
              "format": "float"
            }
          }
        },
        "description": "One frame: `t` in Unix milliseconds and one value per sensor, in the order of the sensor list (`null` = no reading)."
      },
      "HealthResponse": {
        "required": [
          "status",
          "version",
          "storage"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` when the dashboard answers."
          },
          "version": {
            "type": "string",
            "description": "Semantic version of the dashboard."
          },
          "storage": {
            "description": "State of the monitoring database; data endpoints answer 503 unless it is `Ready`.",
            "$ref": "#/components/schemas/StorageState"
          }
        },
        "description": "Liveness of the dashboard, the version that is running and whether the database can be read."
      },
      "HistoryRange": {
        "enum": [
          "Hour",
          "Day",
          "Week",
          "TwoWeeks"
        ]
      },
      "HistoryResponse": {
        "required": [
          "sensor",
          "from",
          "to",
          "bucketSeconds",
          "buckets"
        ],
        "type": "object",
        "properties": {
          "sensor": {
            "description": "The sensor and how to judge it.",
            "$ref": "#/components/schemas/SensorResponse"
          },
          "from": {
            "type": "string",
            "description": "Start of the period.",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "description": "End of the period (now).",
            "format": "date-time"
          },
          "bucketSeconds": {
            "type": "integer",
            "description": "Width of each bucket.",
            "format": "int32"
          },
          "buckets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BucketResponse"
            },
            "description": "Oldest first."
          }
        },
        "description": "One sensor over a period, in buckets. Buckets without readings (machine off) are absent."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Hypothesis": {
        "enum": [
          "PowerSupply",
          "BoardPowerDelivery",
          "Thermal",
          "Software",
          "CpuOrMemory",
          "ForcedPowerOff",
          null
        ]
      },
      "HypothesisScoreResponse": {
        "required": [
          "hypothesis",
          "score"
        ],
        "type": "object",
        "properties": {
          "hypothesis": {
            "$ref": "#/components/schemas/Hypothesis"
          },
          "score": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Sum of the evidence for one hypothesis."
      },
      "IncidentDetailResponse": {
        "required": [
          "summary",
          "lastAliveAt",
          "telemetryEndAt",
          "events",
          "diagnosis",
          "telemetry"
        ],
        "type": "object",
        "properties": {
          "summary": {
            "description": "The list entry.",
            "$ref": "#/components/schemas/IncidentSummaryResponse"
          },
          "lastAliveAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "Last sign of life Windows recorded (event 6008).",
            "format": "date-time"
          },
          "telemetryEndAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "Last frame the collector recorded in that session.",
            "format": "date-time"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventResponse"
            },
            "description": "Windows events this incident owns, oldest first."
          },
          "diagnosis": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "`null` until the collector diagnoses it.",
                "$ref": "#/components/schemas/DiagnosisResponse"
              }
            ]
          },
          "telemetry": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "`null` without telemetry.",
                "$ref": "#/components/schemas/TelemetryResponse"
              }
            ]
          }
        },
        "description": "Everything about one incident."
      },
      "IncidentSummaryResponse": {
        "required": [
          "id",
          "loggedAt",
          "estimatedFailureAt",
          "timeSource",
          "sleepState",
          "bugcheckCode",
          "hasTelemetry",
          "topHypothesis",
          "confidence",
          "observations"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Incident id.",
            "format": "int64"
          },
          "loggedAt": {
            "type": "string",
            "description": "When Windows logged the shutdown (event 41, at the next boot).",
            "format": "date-time"
          },
          "estimatedFailureAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "Best estimate of when the machine went down.",
            "format": "date-time"
          },
          "timeSource": {
            "description": "Where the estimate comes from: `LastFrame` is within about a second.",
            "$ref": "#/components/schemas/FailureTimeSource"
          },
          "sleepState": {
            "type": "integer",
            "description": "Power state in transition at the failure: 0 none, 3 sleep, 4 hibernation/Fast Startup.",
            "format": "int32"
          },
          "bugcheckCode": {
            "type": "integer",
            "description": "Blue screen code; 0 when there was none.",
            "format": "int64"
          },
          "hasTelemetry": {
            "type": "boolean",
            "description": "The collector recorded the session the shutdown ended."
          },
          "topHypothesis": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Most likely cause; `null` when inconclusive or not diagnosed yet.",
                "$ref": "#/components/schemas/Hypothesis"
              }
            ]
          },
          "confidence": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Confidence of the diagnosis; `null` when not diagnosed yet.",
                "$ref": "#/components/schemas/Confidence"
              }
            ]
          },
          "observations": {
            "type": "array",
            "items": {
              "enum": [
                "thermal.critical",
                "thermal.at_limit",
                "thermal.normal",
                "rail.out_of_tolerance",
                "rail.droop",
                "rail.in_tolerance",
                "load.high",
                "load.idle",
                "restart.quick",
                "restart.stayed_off",
                "power.transition",
                "bugcheck",
                "bugcheck.none",
                "whea.hardware_error",
                "whea.pcie",
                "power_button.long_press",
                "power_button.pressed",
                "boot.early_failure",
                "telemetry.missing",
                "telemetry.not_at_failure",
                "telemetry.too_short",
                "estimate.lower_bound",
                "sensor.unavailable",
                "rail.precision",
                "rail.measured_on_board",
                "whea.may_be_power"
              ],
              "type": "string"
            },
            "description": "Codes of the neutral observations (for example `boot.early_failure`)."
          }
        },
        "description": "One unexpected shutdown in the list."
      },
      "LiveEvent": {
        "required": [
          "kind",
          "segmentId",
          "frames",
          "state"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/LiveEventKind"
          },
          "segmentId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "frames": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/FramePoint"
            }
          },
          "state": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LiveState"
              }
            ]
          }
        },
        "description": "One server-sent event of `/api/live/stream`; only the fields of its kind are set."
      },
      "LiveEventKind": {
        "enum": [
          "Frames",
          "Segment",
          "State"
        ],
        "description": "Kind of a live stream event; also its SSE `event` name, in lower case."
      },
      "LiveResponse": {
        "required": [
          "state",
          "session",
          "segmentId",
          "sensors",
          "frames"
        ],
        "type": "object",
        "properties": {
          "state": {
            "description": "Whether frames are arriving.",
            "$ref": "#/components/schemas/LiveState"
          },
          "session": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "`null` when nothing was ever recorded.",
                "$ref": "#/components/schemas/SessionResponse"
              }
            ]
          },
          "segmentId": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Segment to follow on the stream.",
            "format": "int64"
          },
          "sensors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SensorResponse"
            },
            "description": "The sensors, in the order of each frame's values."
          },
          "frames": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FramePoint"
            },
            "description": "Oldest first."
          }
        },
        "description": "What is being recorded now: the latest segment's sensors and its last ten minutes."
      },
      "LiveState": {
        "enum": [
          "NoData",
          "Recording",
          "Stale",
          "Stopped"
        ]
      },
      "PointResponse": {
        "required": [
          "t",
          "v"
        ],
        "type": "object",
        "properties": {
          "t": {
            "type": "integer",
            "format": "int64"
          },
          "v": {
            "type": "number",
            "format": "float"
          }
        },
        "description": "One reading: `t` in Unix milliseconds."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RangeResponse": {
        "required": [
          "min",
          "max"
        ],
        "type": "object",
        "properties": {
          "min": {
            "type": "number",
            "format": "float"
          },
          "max": {
            "type": "number",
            "format": "float"
          }
        },
        "description": "The safe range of a reading, inclusive (ATX ±5 % for supply rails)."
      },
      "RoleSeriesResponse": {
        "required": [
          "role",
          "unit",
          "range",
          "limit",
          "critical",
          "points"
        ],
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/SensorRole"
          },
          "unit": {
            "type": "string"
          },
          "range": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RangeResponse"
              }
            ]
          },
          "limit": {
            "type": [
              "null",
              "number"
            ],
            "format": "float"
          },
          "critical": {
            "type": [
              "null",
              "number"
            ],
            "format": "float"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PointResponse"
            }
          }
        },
        "description": "Readings of one sensor role, with how to judge them."
      },
      "SensorKind": {
        "enum": [
          "Temperature",
          "Voltage",
          "Power",
          "Load",
          "Fan",
          "Level"
        ],
        "description": "Physical quantity a sensor measures."
      },
      "SensorResponse": {
        "required": [
          "key",
          "name",
          "kind",
          "unit",
          "role",
          "range",
          "limit",
          "critical",
          "storage"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Stable key of the sensor."
          },
          "name": {
            "type": "string",
            "description": "Name as recorded."
          },
          "kind": {
            "description": "What it measures.",
            "$ref": "#/components/schemas/SensorKind"
          },
          "unit": {
            "type": "string",
            "description": "Unit of the readings."
          },
          "role": {
            "description": "Meaning on this board (`None` for sensors without one).",
            "$ref": "#/components/schemas/SensorRole"
          },
          "range": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Safe range, for supply rails.",
                "$ref": "#/components/schemas/RangeResponse"
              }
            ]
          },
          "limit": {
            "type": [
              "null",
              "number"
            ],
            "description": "Reading at which to pay attention (CPU at its design limit).",
            "format": "float"
          },
          "critical": {
            "type": [
              "null",
              "number"
            ],
            "description": "Reading that is out of range (CPU shutdown zone).",
            "format": "float"
          },
          "storage": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "For a disk sensor, which disk and what it measures.",
                "$ref": "#/components/schemas/StorageResponse"
              }
            ]
          }
        },
        "description": "A recorded sensor and how to judge its readings."
      },
      "SensorRole": {
        "enum": [
          "None",
          "CpuTemperature",
          "CpuPackagePower",
          "CpuLoad",
          "Vcore",
          "Rail12V",
          "Rail5V",
          "Rail3V3",
          "MemoryLoad"
        ],
        "description": "Meaning of a sensor for diagnosis, independent of how a board names it.\r\nAt most one sensor per catalog holds each role other than SensorRole.None."
      },
      "SensorSourceStatus": {
        "enum": [
          "Ok",
          "DriverMissing",
          "BoardNotDetected"
        ],
        "description": "Whether hardware sensors can be trusted for a session."
      },
      "SessionResponse": {
        "required": [
          "startedAt",
          "sourceStatus",
          "boardProduct"
        ],
        "type": "object",
        "properties": {
          "startedAt": {
            "type": "string",
            "description": "When the collector started recording.",
            "format": "date-time"
          },
          "sourceStatus": {
            "description": "Whether the sensors could be read (`Ok`, or why not).",
            "$ref": "#/components/schemas/SensorSourceStatus"
          },
          "boardProduct": {
            "type": [
              "null",
              "string"
            ],
            "description": "Motherboard model, when known."
          }
        },
        "description": "The collector session being shown."
      },
      "StorageMeasureKind": {
        "enum": [
          "Temperature",
          "WarningTemperature",
          "CriticalTemperature",
          "UsedSpace",
          "Life"
        ]
      },
      "StorageResponse": {
        "required": [
          "disk",
          "measure"
        ],
        "type": "object",
        "properties": {
          "disk": {
            "type": "integer",
            "format": "int32"
          },
          "measure": {
            "$ref": "#/components/schemas/StorageMeasureKind"
          }
        },
        "description": "A disk sensor: the disk (0-based) and what it measures."
      },
      "StorageState": {
        "enum": [
          "Ready",
          "Missing",
          "SchemaTooOld",
          "SchemaTooNew",
          "Unreadable"
        ],
        "description": "Whether the database can be read by this build."
      },
      "TelemetryResponse": {
        "required": [
          "endAt",
          "atFailure",
          "series"
        ],
        "type": "object",
        "properties": {
          "endAt": {
            "type": "string",
            "description": "Last recorded frame.",
            "format": "date-time"
          },
          "atFailure": {
            "type": "boolean",
            "description": "The window ends at the failure; otherwise the collector had stopped or the machine was asleep."
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleSeriesResponse"
            },
            "description": "One series per recorded role; readings without a value are left out."
          }
        },
        "description": "The recorded seconds before the end of telemetry, by sensor role."
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Incidents"
    },
    {
      "name": "Live"
    },
    {
      "name": "History"
    }
  ]
}