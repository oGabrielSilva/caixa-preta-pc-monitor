{
  "name": "pc-monitor-dashboard-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../PcMonitor.Dashboard/openapi/PcMonitor.Dashboard.json -o app/api/schema.d.ts",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@iconify-json/material-symbols": "^1.2.101",
    "@nuxt/ui": "4.13.1",
    "@nuxtjs/i18n": "10.6.0",
    "@tanstack/charts": "1.5.0",
    "exceljs": "4.4.0",
    "nuxt": "4.6.4",
    "openapi-fetch": "0.17.0",
    "pdfmake": "0.3.15",
    "tailwindcss": "4.3.5",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.4.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/pdfmake": "0.3.4",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "happy-dom": "21.0.4",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
